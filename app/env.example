# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=5090
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=http://192.168.1.10:5090     # https://… behind DSM's reverse proxy
SSL_PROXY=0
X_SETTINGS=                          # 1 behind DSM's reverse proxy
CD_IMAGE=ghcr.io/dgtlmoon/changedetection.io:0.60.9   # pinned; moved on by the window's Update button or a newer package
BROWSER_IMAGE=dgtlmoon/sockpuppetbrowser:latest
USE_BROWSER=0                        # 1: the Chrome browser runs too
COMPOSE_PROFILES=                    # browser when USE_BROWSER=1
BROWSER_URL=                         # ws://browser:3000 when USE_BROWSER=1
LAN_PAGES=false                      # true: pages on your own network may be watched
DSM_NOTIFY=changes                   # changes | all (changes and failing checks) | off — DSM notifications
